{
  "name": "breadcrumbs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "extension": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check entrypoints src tests wxt.config.ts",
    "format": "biome check --write entrypoints src tests wxt.config.ts",
    "check": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wxt": "^0.21.2"
  }
}
